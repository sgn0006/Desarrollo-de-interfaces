<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="informe_mascotas" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35" whenNoDataType="AllSectionsNoDetail">
    <parameter name="titulo" class="java.lang.String"/>
    <parameter name="numeroMascotas" class="java.lang.Integer"/>
    <parameter name="estanciaMedia" class="java.lang.Double"/>
    <parameter name="fechaGeneracion" class="java.lang.String"/>

    <title height="105">
        <element kind="staticText" x="0" y="5" width="515" height="25" hTextAlign="Center" vTextAlign="Middle" fontSize="10" bold="true">
            <text><![CDATA[REFUGIO DE ANIMALES]]></text>
        </element>
        <element kind="textField" x="0" y="35" width="515" height="40" hTextAlign="Center" vTextAlign="Middle" fontSize="22" bold="true">
            <expression><![CDATA[$P{titulo}]]></expression>
        </element>
        <element kind="line" x="0" y="90" width="515" height="1"/>
    </title>

    <pageFooter height="25">
        <element kind="line" x="0" y="0" width="515" height="1"/>
        <element kind="staticText" x="0" y="6" width="300" height="15" vTextAlign="Middle" fontSize="8">
            <text><![CDATA[Informe de gestión del refugio]]></text>
        </element>
        <element kind="textField" x="455" y="6" width="60" height="15" hTextAlign="Right" vTextAlign="Middle" fontSize="8">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>

    <summary height="225">
        <element kind="staticText" x="0" y="10" width="515" height="25" vTextAlign="Middle" fontSize="14" bold="true">
            <text><![CDATA[Resumen de registros]]></text>
        </element>
        <element kind="rectangle" x="0" y="50" width="245" height="95"/>
        <element kind="staticText" x="15" y="62" width="215" height="22" hTextAlign="Center" vTextAlign="Middle" fontSize="11" bold="true">
            <text><![CDATA[Total de mascotas]]></text>
        </element>
        <element kind="textField" x="15" y="88" width="215" height="42" hTextAlign="Center" vTextAlign="Middle" fontSize="25" bold="true">
            <expression><![CDATA[$P{numeroMascotas} == null ? "0" : $P{numeroMascotas}.toString()]]></expression>
        </element>
        <element kind="rectangle" x="270" y="50" width="245" height="95"/>
        <element kind="staticText" x="285" y="62" width="215" height="22" hTextAlign="Center" vTextAlign="Middle" fontSize="11" bold="true">
            <text><![CDATA[Estancia media (días)]]></text>
        </element>
        <element kind="textField" x="285" y="88" width="215" height="42" hTextAlign="Center" vTextAlign="Middle" fontSize="25" bold="true" pattern="#,##0.00">
            <expression><![CDATA[$P{estanciaMedia} == null ? java.lang.Double.valueOf(0) : $P{estanciaMedia}]]></expression>
        </element>
        <element kind="line" x="0" y="170" width="515" height="1"/>
        <element kind="textField" x="0" y="183" width="515" height="25" vTextAlign="Middle" fontSize="10" italic="true">
            <expression><![CDATA[$P{fechaGeneracion}]]></expression>
        </element>
    </summary>
</jasperReport>
