<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_mascotas"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="35"
              bottomMargin="35"
              whenNoDataType="AllSectionsNoDetail"
              language="java">

    <parameter name="titulo" class="java.lang.String"/>
    <parameter name="numeroMascotas" class="java.lang.Integer"/>
    <parameter name="estanciaMedia" class="java.lang.Double"/>
    <parameter name="fechaGeneracion" class="java.lang.String"/>

    <title>
        <band height="105">
            <staticText>
                <reportElement x="0" y="5" width="515" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[REFUGIO DE ANIMALES]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="515" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="22" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{titulo}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="90" width="515" height="1"/>
            </line>
        </band>
    </title>

    <summary>
        <band height="225">
            <staticText>
                <reportElement x="0" y="10" width="515" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[Resumen de registros]]></text>
            </staticText>

            <rectangle>
                <reportElement x="0" y="50" width="245" height="95"/>
            </rectangle>
            <staticText>
                <reportElement x="15" y="62" width="215" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Total de mascotas]]></text>
            </staticText>
            <textField>
                <reportElement x="15" y="88" width="215" height="42"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="25" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{numeroMascotas} == null ? "0" : $P{numeroMascotas}.toString()]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="270" y="50" width="245" height="95"/>
            </rectangle>
            <staticText>
                <reportElement x="285" y="62" width="215" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Estancia media (días)]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="285" y="88" width="215" height="42"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="25" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{estanciaMedia} == null ? java.lang.Double.valueOf(0) : $P{estanciaMedia}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="170" width="515" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="183" width="515" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{fechaGeneracion}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <pageFooter>
        <band height="25">
            <line>
                <reportElement x="0" y="0" width="515" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="6" width="300" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Informe de gestión del refugio]]></text>
            </staticText>
            <textField>
                <reportElement x="455" y="6" width="60" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
