<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="informe_mascotas" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35" whenNoDataType="AllSectionsNoDetail">
    <parameter name="titulo" class="java.lang.String"/>
    <parameter name="numeroMascotas" class="java.lang.Integer"/>
    <parameter name="estanciaMedia" class="java.lang.Double"/>
    <parameter name="fechaGeneracion" class="java.lang.String"/>
    <title height="70">
        <element kind="textField" x="0" y="10" width="515" height="45" fontSize="22" bold="true" hTextAlign="Center">
            <expression><![CDATA[$P{titulo}]]></expression>
        </element>
    </title>
    <summary height="160">
        <element kind="staticText" x="0" y="10" width="250" height="25" fontSize="12" bold="true">
            <text><![CDATA[Número de mascotas]]></text>
        </element>
        <element kind="textField" x="260" y="10" width="200" height="25" fontSize="12">
            <expression><![CDATA[$P{numeroMascotas}]]></expression>
        </element>
        <element kind="staticText" x="0" y="50" width="250" height="25" fontSize="12" bold="true">
            <text><![CDATA[Estancia media (días)]]></text>
        </element>
        <element kind="textField" x="260" y="50" width="200" height="25" fontSize="12" pattern="#,##0.00">
            <expression><![CDATA[$P{estanciaMedia}]]></expression>
        </element>
        <element kind="textField" x="0" y="105" width="515" height="25" fontSize="10">
            <expression><![CDATA[$P{fechaGeneracion}]]></expression>
        </element>
    </summary>
</jasperReport>
